{
  "name": "sequelize",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:file": "sequelize-cli db:migrate --to",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:file": "sequelize-cli db:migrate:undo --name",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:generate": "sequelize-cli migration:generate --name",
    "db:seed:generate": "sequelize-cli seed:generate --name",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:file": "sequelize-cli db:seed --seed",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "Meetraj Parmar",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "sequelize-cli": "^6.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
